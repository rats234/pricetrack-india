{
  "manifest_version": 3,
  "name": "PriceTrack India",
  "version": "0.3.0",
  "description": "Find out if a product you're viewing on an Indian retailer is cheaper elsewhere.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*",
    "https://www.myntra.com/*",
    "https://www.ajio.com/*",
    "https://www.croma.com/*",
    "https://www.reliancedigital.in/*",
    "https://www.nykaa.com/*",
    "https://www.purplle.com/*",
    "https://www.tirabeauty.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/amazon.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.flipkart.com/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/flipkart.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.myntra.com/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/generic.js",
        "src/content/extractors/myntra.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ajio.com/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/generic.js",
        "src/content/extractors/ajio.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.croma.com/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/generic.js",
        "src/content/extractors/croma.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reliancedigital.in/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/generic.js",
        "src/content/extractors/reliance-digital.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.nykaa.com/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/generic.js",
        "src/content/extractors/nykaa.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.purplle.com/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/generic.js",
        "src/content/extractors/purplle.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tirabeauty.com/*"
      ],
      "js": [
        "src/content/extractors/common.js",
        "src/content/extractors/generic.js",
        "src/content/extractors/tira.js",
        "src/content/inject.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
